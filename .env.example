# =====================================================================
# 監査対象のディレクトリ設定
# =====================================================================
# 監査対象のHTMLファイルが格納されているローカルマシンのディレクトリパスを指定します。
# 最後にスラッシュ(/)は入れないでください。

# 【例1】 相対パスでの指定（この wcag フォルダからの相対パス）
HTML_SOURCE_DIR=../source/project/html

# 【例2】 絶対パス（フルパス）での指定
# HTML_SOURCE_DIR=/Users/user/Documents/source/project/html


# =====================================================================
# 監査対象のファイル設定
# =====================================================================
# 監査したいファイル名を指定します（カンマ [,] または スペースで区切って複数指定が可能）。
# 上記で指定した HTML_SOURCE_DIR を起点とした相対パスで記述します。

# 【例1】 直下にあるファイルを複数指定する
# TARGET_FILES=index.html, about.html, contact.html

# 【例2】 階層（サブディレクトリ）の中にあるファイルを指定する
# TARGET_FILES=index.html, company/info.html, company/history/index.html

# 【例3】 ローカルファイルと外部WebサイトのURLを混在させる
# TARGET_FILES=index.html, https://example.com/live-page

# 現在の有効な設定
TARGET_FILES=index.html, about.html
